# AutoLease - Local Environment Variables Template
# Copy this file to .env and replace the placeholders with your Supabase credentials:
#   Copy-Item .env.example .env
#
# Credentials can be found in Supabase Dashboard:
# Project Settings > Database > Connection parameters OR Connect > Session pooler.


SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.your-project-ref
SUPABASE_DB_PASSWORD=your-database-password
SUPABASE_DB_HOST=aws-0-region.pooler.supabase.com
SUPABASE_DB_PORT=5432

# Optional test database configuration (defaults shown)
# TEST_DB_NAME=autolease_test
# TEST_DB_USER=postgres
# TEST_DB_PASSWORD=postgres
# TEST_DB_HOST=localhost
# TEST_DB_PORT=5432

